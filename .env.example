# ===== 控制邮箱 =====
CONTROL_EMAIL=alivebeacon01@163.com
CONTROL_PASS=your-app-password
IMAP_HOST=imap.163.com
IMAP_PORT=993
SMTP_HOST=smtp.163.com
SMTP_PORT=465

# ===== 白名单（逗号分隔，回信发件人在此列表内即命中）=====
WHITELIST_EMAILS=you1@163.com,you2@outlook.com

# ===== 目标仓库 =====
REMOTE_REPO=owner/repo
REMOTE_FILE=alive.txt
REMOTE_BRANCH=main
REMOTE_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ===== 目标文件标记（程序只改两行标记之间的内容）=====
REMOTE_BLOCK_START=<!-- alive_start -->
REMOTE_BLOCK_END=<!-- alive_end -->

# ===== 状态裁剪 =====
MAX_SENT_IDS=30
MAX_PROCESSED_UIDS=100

# ===== 调试开关 =====
DRY_RUN=true
MAIL_DRY=true
LOG_LEVEL=INFO